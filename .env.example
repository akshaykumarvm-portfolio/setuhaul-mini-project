# --- LLM (agent only) ---
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Redis (Upstash, TLS) : rediss://default:<token>@<host>.upstash.io:6379 ---
REDIS_URL=

# --- LangSmith ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=setuhaul

# --- Booking service ---
# Source snapshot is never written to; a migrated copy is created at SETUHAUL_DB_PATH.
SETUHAUL_SOURCE_DB=data/setuhaul_freight_operations.db
# Default is ~/.setuhaul/setuhaul.db (outside OneDrive: sync locks break SQLite WAL)
SETUHAUL_DB_PATH=
# Simulated clock start (Asia/Kolkata). Rate 1.0 = real-time after the anchor.
SIM_START=2026-08-04T09:30:00+05:30
SIM_RATE=1.0
