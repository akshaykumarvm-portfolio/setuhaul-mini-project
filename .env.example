# --- LLM (agent only) ---
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Redis (Upstash, TLS) : rediss://default:<token>@<host>.upstash.io:6379 ---
REDIS_URL=

# --- LangSmith ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=setuhaul

# --- Booking service ---
# System of record. Local: postgresql://postgres@localhost:5432/setuhaul
# AWS: postgresql://<user>:<pw>@<rds-endpoint>:5432/setuhaul?sslmode=require
DATABASE_URL=
# Supplied seed SQL. Local default: data/setuhaul_schema_and_seed.sql
# AWS: s3://<bucket>/snapshot/2026-08-04/setuhaul_schema_and_seed.sql (read into memory, never saved)
SNAPSHOT_URI=
AWS_REGION=us-east-1
# Simulated clock start (Asia/Kolkata). Rate 1.0 = real time after the anchor; 0 = frozen.
SIM_START=2026-08-04T10:00:00+05:30
SIM_RATE=1.0

# Tests only (never the real DB): clones a template per test
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/postgres

# --- Agent ---
# Where the agent reaches the booking service (local: http://localhost:8000)
BOOKING_API_URL=http://localhost:8000
# Optional: fallback and extraction models (default fallback openai/gpt-4.1-mini; extraction = main model)
OPEN_ROUTER_FALLBACK_MODEL=openai/gpt-4.1-mini
OPEN_ROUTER_EXTRACTION_MODEL=
